# Copie para ".env" e preencha. NUNCA versione o .env real.
#   cp .env.example .env

# Chave secreta do Flask (gere uma aleatória e mantenha em segredo):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-hex

# Autenticação HTTP Basic. Defina AMBOS para exigir login em todas as rotas.
# Obrigatório se a aplicação for exposta na internet pública (LGPD/PII).
APP_AUTH_USERNAME=coordenador
APP_AUTH_PASSWORD=troque-por-uma-senha-forte

# Nunca ative debug em produção.
FLASK_DEBUG=false

# Está atrás de um reverse proxy (nginx)? Ativa ProxyFix + HSTS.
BEHIND_PROXY=true

# Limite de upload em MB.
MAX_UPLOAD_MB=16

# Rate limiting no app (defense-in-depth; o proxy também limita).
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_UPLOAD=20 per minute
# Para rate limit consistente entre múltiplos workers, use Redis:
# RATE_LIMIT_STORAGE=redis://redis:6379

# Gunicorn (produção).
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
